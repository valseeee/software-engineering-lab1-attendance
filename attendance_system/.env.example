# Flask
SECRET_KEY=dev-secret-key

# 通用数据库连接。优先级最高；配置后会覆盖 DB_BACKEND / MYSQL_*。
# SQLite 开发回退示例：
# DATABASE_URL=sqlite:///instance/lemon.db
#
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/lemon?charset=utf8mb4
DATABASE_URL=

# 未设置 DATABASE_URL 时可使用 DB_BACKEND 切换。
# sqlite: 使用 instance/lemon.db
# mysql: 使用下面的 MYSQL_* 组装连接串
DB_BACKEND=sqlite

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=lemon
MYSQL_USER=root
MYSQL_PASSWORD=123456

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LONG_ANALYSIS_MODEL=deepseek-reasoner
